# Environment for nbdash.service.
#
# Install to /etc/nbdash/nbdash.env owned by root with mode 0600 —
# it holds AUTH_CLIENT_SECRET. systemd reads it as root before dropping to the
# DynamicUser identity, so the service account never needs read access.
#
# Syntax note: this is not a shell script. systemd does not expand $VARIABLES
# and does not strip quotes the way bash does. Write plain KEY=value.

# --- Required --------------------------------------------------------------

# NetBird Management API. "/api" is appended by the dashboard, so omit it here.
NETBIRD_MGMT_API_ENDPOINT=https://api.netbird.io

# OIDC issuer. Must serve /.well-known/openid-configuration.
AUTH_AUTHORITY=https://your-tenant.eu.auth0.com

AUTH_CLIENT_ID=replace-me

# Required by this dashboard but NOT by the Next.js one: the authorization-code
# exchange happens server-side here, so the client is confidential. Register the
# application as a "Regular Web Application" rather than a SPA.
AUTH_CLIENT_SECRET=replace-me

# The public URL users reach, not the internal bind address. Register this exact
# value as an allowed callback URL with your provider.
#
# Required, with no default. Its scheme also decides whether the session cookie
# carries the Secure flag: https:// sets it, http:// does not. It previously
# defaulted to http://localhost:8080/auth/callback, which meant a deployment
# that forgot to set it shipped the session cookie in clear text while
# appearing to work — so the dashboard now refuses to start without it.
#
# Use http:// only for local development.
AUTH_REDIRECT_URI=https://dashboard.example.com/auth/callback

# --- Recommended -----------------------------------------------------------

# Auth0 needs an audience to issue a JWT for the Management API instead of an
# opaque token. Set to "none" for providers that reject the parameter.
AUTH_AUDIENCE=https://api.netbird.io

# offline_access is what yields a refresh token. Without it, sessions end when
# the access token expires instead of renewing.
AUTH_SUPPORTED_SCOPES=openid profile email offline_access api

# --- Optional --------------------------------------------------------------

# Bind address. Keep it on loopback when a reverse proxy terminates TLS.
LISTEN_ADDR=127.0.0.1:8080

# Which token is presented to the Management API: accessToken (default) or
# idToken. Match whatever your Management server validates.
NETBIRD_TOKEN_SOURCE=accessToken
